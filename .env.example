# Backend
APP_NAME="Secure File Encryption Platform"
APP_VERSION=0.1.0
# Commit reported by /health/live. Leave unset on the VPS: mcs21-deploy writes it to the
# release's .mcs21-release file, which the backend reads when this is empty.
APP_COMMIT=
APP_ENV=development
APP_DEBUG=true
# Keep true for local development. A public deployment must make an explicit decision:
# SecureView staging enables it for supervisor evaluation and API demonstrations.
APP_DOCS_ENABLED=true
API_PREFIX=/api/v1
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_REFRESH_MIN_INTERVAL_SECONDS=10
SESSION_ABSOLUTE_EXPIRE_HOURS=168
AUTH_MAX_ACTIVE_SESSIONS=10
AUTH_PASSWORD_HASH_CONCURRENCY=2
AUTH_LOGIN_ACCOUNT_MAX_FAILURES=10
AUTH_LOGIN_IP_MAX_FAILURES=500
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_ACCOUNT_BLOCK_SECONDS=300
AUTH_LOGIN_IP_BLOCK_SECONDS=900
AUTH_REAUTH_ACCOUNT_MAX_FAILURES=5
AUTH_REAUTH_IP_MAX_FAILURES=200
AUTH_REAUTH_BLOCK_SECONDS=300
AUTH_REGISTRATION_MAX_ATTEMPTS=200
AUTH_REGISTRATION_WINDOW_SECONDS=3600
AUTH_REGISTRATION_BLOCK_SECONDS=3600
USER_RSA_KEY_SIZE=3072

# Emailed verification codes (registration and password reset)
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_RESEND_INTERVAL_SECONDS=60
VERIFICATION_SEND_EMAIL_MAX_PER_WINDOW=5
VERIFICATION_SEND_IP_MAX_PER_WINDOW=300
VERIFICATION_CHECK_EMAIL_MAX_FAILURES=10
VERIFICATION_CHECK_IP_MAX_FAILURES=500
VERIFICATION_THROTTLE_WINDOW_SECONDS=3600
VERIFICATION_THROTTLE_BLOCK_SECONDS=900

# Outbound email. "console" only logs the message and is rejected outside
# development/test. Use "resend" (HTTPS API) or "smtp" for real delivery.
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@localhost
EMAIL_FROM_NAME=SecureView
# EMAIL_REPLY_TO=support@example.com
EMAIL_TIMEOUT_SECONDS=10

# Resend: verify the sending domain (SPF + DKIM DNS records) first, then send
# from any address on it. The address needs no real inbox.
# EMAIL_PROVIDER=resend
# EMAIL_FROM_ADDRESS=no-reply@auth.your-domain.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_URL=https://api.resend.com/emails

# Generic SMTP. Resend also offers SMTP: host smtp.resend.com, port 587,
# username "resend", password the same API key.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# API/runtime (CORS_ORIGINS must be a JSON array)
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
CORS_ALLOW_CREDENTIALS=true
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_SIZE_BYTES=524288000
MAX_UPLOAD_REQUEST_OVERHEAD_BYTES=262144
# Upload abuse limits (threat model T-D2). 0 turns one off, e.g. during a capacity test.
USER_STORAGE_QUOTA_BYTES=2147483648
USER_DAILY_UPLOAD_BYTES=5368709120
UPLOAD_MIN_FREE_DISK_BYTES=2147483648
LOG_LEVEL=INFO

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=fyp_user
DB_PASSWORD=fyp_password
DB_NAME=fyp_secure_file_platform
# Production requires a CA bundle and verifies the MySQL certificate hostname.
# DB_SSL_CA=/run/secrets/mysql-ca.pem
# DB_SSL_CERT=/run/secrets/mysql-client-cert.pem
# DB_SSL_KEY=/run/secrets/mysql-client-key.pem
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_PORT=3306

# Storage
ENCRYPTED_FILE_DIR=backend/encrypted_files
TEMP_FILE_DIR=backend/temp_files
# Plaintext profile pictures. Keep outside the release tree and apart from ciphertext.
AVATAR_DIR=backend/avatars
