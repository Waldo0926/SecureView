# Installed and enabled by `mcs21-deploy` after each healthy release (it is on that script's
# closed list of ops units, and the script refuses it if it stops running as fypapp or starts
# anything but scripts/<name>.py). docs/SECURITY_AGENT.md, "Proactive alerts", says what a
# failure of this unit means.
#
# Manual run, as the service account:
#
#   sudo systemd-run --pipe --wait --quiet --uid=fypapp --gid=fypapp \
#     --working-directory=/opt/mcs21/current/backend \
#     --property=EnvironmentFile=/etc/fyp-secure-file-platform/backend.env \
#     /opt/mcs21/current/backend/.venv/bin/python scripts/security_agent_check.py
#
# Exit status 3 means the agent has Critical or High findings for the last 24 hours; that is a
# finding, not a crash, and the OnFailure= alert below is how it reaches a person. The journal
# line holds counts and rule ids only; the details are on Admin -> Security agent.

[Unit]
Description=MCS21 security agent: daily check for Critical or High findings
Wants=network-online.target
After=network-online.target docker.service
OnFailure=mcs21-alert@%n.service

[Service]
Type=oneshot
User=fypapp
Group=fypapp
WorkingDirectory=/opt/mcs21/current/backend
EnvironmentFile=/etc/fyp-secure-file-platform/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/mcs21/current/backend/.venv/bin/python scripts/security_agent_check.py
TimeoutStartSec=10min
Nice=15

# Reads the database only: no file, no object store, no write path anywhere on disk.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=/var/lib/fyp-secure-file-platform
