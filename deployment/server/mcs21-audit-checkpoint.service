# Issue #59: publish an HMAC-authenticated audit-chain anchor outside the application DB.
# The HMAC key is root-only and never enters the application environment or process.
# Installation and key generation are documented in docs/OBSERVABILITY_AND_INCIDENT_RESPONSE.md.

[Unit]
Description=Publish SecureView external audit-chain checkpoint
Wants=network-online.target
After=network-online.target docker.service
OnFailure=mcs21-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/mcs21/current/backend
EnvironmentFile=/etc/fyp-secure-file-platform/backup.env
EnvironmentFile=/etc/fyp-secure-file-platform/audit-checkpoint.env
UMask=0077
ExecStart=/opt/mcs21/current/backend/.venv/bin/python scripts/audit_checkpoint.py create \
    --key-file /etc/fyp-secure-file-platform/audit-checkpoint.key \
    --dest ${AUDIT_CHECKPOINT_DEST} \
    --release-file /opt/mcs21/current/.mcs21-release \
    --stamp-file /var/lib/mcs21-observe/audit-checkpoint.latest

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/mcs21-observe
